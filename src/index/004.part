div class="process-step"><b>02</b><strong>STRUCTURE</strong><small>Hành trình, nội dung, CTA</small></div>
          <div class="process-step"><b>03</b><strong>DESIGN</strong><small>UI, nhận diện, responsive</small></div>
          <div class="process-step"><b>04</b><strong>BUILD</strong><small>Phát triển và tối ưu</small></div>
          <div class="process-step"><b>05</b><strong>TRACKING</strong><small>Analytics và conversion</small></div>
          <div class="process-step"><b>06</b><strong>LAUNCH</strong><small>QA và bàn giao</small></div>
        </div>
      </div>
    </section>

