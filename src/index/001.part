            <a class="btn btn-ghost" href="#work">Xem dự án <span aria-hidden="true">→</span></a>
          </div>
          <div class="capabilities" aria-label="Năng lực chính">
            <span>Landing Page</span><i></i><span>Website</span><i></i><span>Google Ads</span><i></i><span>Tracking</span>
          </div>
        </div>

        <div class="hero-visual reveal delay-1" aria-label="Minh họa website và hệ thống tracking">
          <div class="browser-card">
            <div class="browser-top"><span></span><span></span><span></span><em>qtd.digital</em></div>
            <div class="browser-body">
              <div class="mini-sidebar">
                <div class="mini-logo">Q</div>
                <div class="mini-line active"></div>
                <div class="mini-line"></div>
                <div class="mini-line short"></div>
              </div>
              <div class="mini-page">
                <div class="mini-badge">PERFORMANCE</div>
                <div class="mini-title"></div>
                <div class="mini-title short"></div>
                <div class="mini-text"></div>
                <div class="mini-text short"></div>
                <div class="mini-buttons"><span></span><span></span></div>
                <div class="mini-chart">
                  <svg viewBox="0 0 320 100" role="img" aria-label="Biểu đồ tăng trưởng minh họa">
