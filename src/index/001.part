<body>
  <a class="skip-link" href="#main">Bỏ qua đến nội dung chính</a>

  <header class="site-header" id="top">
    <div class="container nav-wrap">
      <a class="brand" href="#top" aria-label="QTD Digital trang chủ">
        <span class="brand-mark" aria-hidden="true">Q</span>
        <span class="brand-copy"><strong>QTD</strong><small>DIGITAL</small></span>
      </a>

      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Mở menu">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="main-nav" aria-label="Điều hướng chính">
        <a href="#services">Dịch vụ</a>
