 solid #E3E9F0;transition:.22s ease;overflow:hidden}.service-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.service-card.featured{background:var(--navy);color:#fff;border-color:var(--navy)}.service-card.featured:after{content:"";position:absolute;width:250px;height:250px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,255,.35),transparent 68%);right:-70px;bottom:-90px}.service-num{font-size:11px;letter-spacing:.14em;color:#8B9AAF}.featured .service-num{color:#7EA9FF}.service-icon{position:absolute;right:26px;top:24px;width:48px;height:48px;border-radius:14px;background:#EDF3FF;color:var(--blue);display:grid;place-items:center;font-size:21px}.featured .service-icon{background:rgba(37,99,255,.14);color:#79A7FF}.service-card h3{font-size:25px;letter-spacing:-.035em;margin:88px 0 12px}.service-card p{font-size:14px;color:var(--muted);max-width:490px}.featured p{color:#9FAFC2}.service-card a{display:inline-block;margin-top:17px;color:var(--blue);font-size:13px;font-weight:700}.featured a{color:#8EB4FF}

.journey{overflow:hidden}.journey-intro{max-width:960px}.journey h2{margin-top:18px}.journey-flow{margin-top:60px;display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr auto 1fr;gap:16px;align-items:center}.journey-flow>span{color:#4B6078}.flow-node{border:1px solid var(--line-dark);border-radius:16px;padding:22px;background:rgba(255,255,255,.025);min-height:108px}.flow-node strong{font-size:13px;letter-spacing:.04em}.flow-node small{display:block;margin-top:14px;color:#8FA2B9;font-size:11px}

.work{background:#fff}.project-row{display:grid;grid-template-columns:1.15fr .85fr;gap:72px;align-items:center;padding:58px 0;border-top:1px solid var(--line)}.project-row.reverse{grid-template-columns:.85fr 1.15fr}.project-row.reverse .project-visual{order:2}.project-row.reverse .project-copy{order:1}.project-visual{height:465px;border-radius:24px;position:relative;overflow:hidden;display:grid;place-items:center;padding:38px}.project-green{background:linear-gradient(145deg,#D9F0E5,#EAF8F2)}.project-industrial{background:linear-gradient(145deg,#E9EEF4,#DCE4ED)}.project-commerce{background:linear-gradient(145deg,#E8EEFF,#F5F7FF)}.project-browser{width:82%;height:78%;background:#fff;border-radius:13px;box-shadow:0 26px 60px rgba(28,49,72,.18);overflow:hidden}.project-bar{height:25px;background:#F0F3F7;display:flex;align-items:center;gap:5px;padding:0 9px}.project-bar i{width:5px;height:5px;background:#CDD5DF;border-radius:50%}.project-content{padding:28px 32px;position:relative;height:calc(100% - 25px)}.project-chip{font-size:7px;font-weight:800;letter-spacing:.16em;color:#1A8B62}.project-content h4{font-size:25px;line-height:1.08;letter-spacing:-.04em;margin:15px 0 13px}.project-lines{width:55%;height:5px;background:#CFD8E2;border-radius:5px;box-shadow:0 12px #E1E6EC,0 24px #E1E6EC}.project-content button{position:absolute;bottom:27px;left:32px;border:0;border-radius:7px;background:#1D7B5C;color:#fff;font-size:7px;font-weight:700;padding:10px 13px}.project-phone{position:absolute;width:108px;height:226px;background:#0C1521;border-radius:22px;padding:5px;right:36px;bottom:26px;box-shadow:0 20px 44px rgba(26,46,69,.25)}.project-phone>div{height:100%;background:#fff;border-radius:17px;padding:25px 10px}.project-phone span{display:block;width:30px;height:5px;background:#1A8B62;border-radius:4px}.project-phone h5{font-size:9px;margin:20px 0 7px}.project-phone p{height:4px;width:80%;background:#D9E1E9;border-radius:3px}.project-phone button{width:70%;height:17px;border:0;border-radius:4px;background:#1A8B62}.project-industrial .project-chip{color:var(--blue)}.machine-art{position:absolute;right:26px;bottom:32px;width:150px;height:115px}.machine-body{position:absolute;right:0;bottom:0;width:106px;height:75px;background:#647386;border-radius:5px}.machine-head{position:absolute;left:10px;top:2px;width:72px;height:55px;border:11px solid #8190A3;border-bottom-width:18px}.laser{position:absolute;width:2px;height:65px;background:#2C8CFF;left:67px;top:33px;box-shadow:0 0 10px #2C8CFF}.project-industrial .project-content button{background:var(--blue)}.project-industrial .project-phone span,.project-industrial .project-phone button{background:var(--blue)}.project-copy .project-type{font-size:10px;letter-spacing:.14em;font-weight:800;color:var(--blue)}.project-copy h3{font-size:38px;letter-spacing:-.045em;margin:15px 0 14px}.project-copy p{color:var(--muted);font-size:14px;line-height:1.75}.tag-list{display:f