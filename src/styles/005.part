height:46px;border:1px solid #DDE4EC;border-radius:10px;background:#FBFCFE;padding:0 12px;color:var(--ink);outline:none}.lead-form input:focus,.lead-form select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,255,.09)}.form-status{font-size:11px;margin:10px 0 0;min-height:18px;color:var(--muted)}.form-status.success{color:#137A4A}.form-status.error{color:#C03636}

.site-footer{background:#050C15;color:#fff;padding:64px 0 24px;border-top:1px solid rgba(255,255,255,.08)}.footer-grid{display:grid;grid-template-columns:1.7fr .7fr .7fr;gap:60px}.footer-brand{margin-bottom:16px}.footer-grid p{font-size:11px;color:#7F92AA}.footer-grid>div:not(:first-child){display:grid;align-content:start;gap:10px}.footer-grid strong{font-size:9px;letter-spacing:.14em;color:#7F92AA;margin-bottom:8px}.footer-grid a:not(.brand){font-size:12px;color:#B6C5D7}.footer-grid a:hover{color:#fff}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:50px;padding-top:22px;border-top:1px solid rgba(255,255,255,.08);font-size:9px;color:#63768E}

.reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}.reveal.visible{opacity:1;transform:none}.delay-1{transition-delay:.08s}.delay-2{transition-delay:.15s}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.btn,.problem-card,.service-card{transition:none}}

@media (max-width:1000px){
  .main-nav{gap:18px}.hero-grid{grid-template-columns:1fr}.hero{padding-top:140px}.hero-visual{min-height:500px;max-width:700px;width:100%;margin:0 auto}.browser-card{width:88%;right:2%}.problem-grid{grid-template-columns:repeat(2,1fr)}.journey-flow{grid-template-columns:1fr}.journey-flow>span{transform:rotate(90deg);justify-self:center}.project-row,.project-row.reverse{grid-template-columns:1fr;gap:34px}.project-row.reverse .project-visual,.project-row.reverse .project-copy{order:initial}.project-visual{height:430px}.process-line{grid-template-columns:repeat(3,1fr);row-gap:48px}.pricing-grid{grid-template-columns:1fr}.price-card{min-height:auto}.price-card.popular{transform:none}.faq-grid,.contact-grid{grid-template-columns:1fr}.faq-grid{gap:30px}.contact-grid{gap:48px}.lead-form{max-width:650px}.footer-grid{grid-template-columns:1.3fr 1fr 1fr}
}

@media (max-width:760px){
  .container{width:min(var(--container),calc(100% - 28px))}.section{padding:78px 0}.site-header{height:68px}.menu-toggle{display:flex;position:relative;z-index:1001}.main-nav{position:fixed;inset:68px 0 auto 0;background:#081320;border-top:1px solid rgba(255,255,255,.08);padding:18px 18px 24px;display:none;flex-direction:column;align-items:stretch;gap:0;box-shadow:0 20px 50px rgba(0,0,0,.28)}.main-nav.open{display:flex}.main-nav a{padding:13px 4px;border-bottom:1px solid rgba(255,255,255,.06)}.main-nav .nav-cta{margin:14px 0 0;border-bottom:0}.hero{padding:115px 0 66px;min-height:auto}.hero-grid{gap:34px}.hero h1{font-size:clamp(40px,12.3vw,58px);line-height:1.01;margin-top:18px}.hero-lead{font-size:15px;line-height:1.7}.hero-actions{flex-direction:column;align-items:stretch}.hero-actions .btn{width:100%}.capabilities{font-size:10px;gap:9px}.hero-visual{min-height:390px}.browser-card{top:24px;width:95%;right:0;transform:none}.browser-body{height:260px;grid-template-columns:42px 1fr}.mini-sidebar{padding:15px 9px}.mini-logo{width:20px;height:20px;margin-bottom:22px}.mini-page{padding:32px 24px}.mini-chart{left:24px;height:78px}.phone-card{width:120px;height:244px;left:0;bottom:0;border-width:5px;border-radius:22px}.phone-screen{padding:27px 11px 12px}.phone-panel{height:80px}.fc-one{left:auto;right:8px;top:3px}.fc-two{right:0;bottom:20px}.fc-three{display:none}.floating-card{padding:8px 9px}.floating-card strong{font-size:8px}.floating-card small{font-size:7px}.status-icon{width:20px;height:20px}.strip-inner{align-items:flex-start;gap:12px;flex-direction:column;padding:18px 0}.strip-items{width:100%;overflow:auto;justify-content:flex-start;padding-bottom:4px}.split-heading{grid-template-columns:1fr;gap:12px}.section-heading{margin-bottom:34px}.section-heading h2,.journey h2,.contact h2{font-size:38px}.problem-grid,.service-grid{grid-template-columns:1fr}.service-card{min-height:290px}.journey-flow{margin-top:36px}.flow-node{min-height:auto}.project-row{padding:42px 0}.project-visual{height:310px;padding:22px}.project-browser{width:90%;height:80%}.project-content{padding:20px}.project-content h4{font-size:18px}.project-cont