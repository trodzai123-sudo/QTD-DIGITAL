lex;flex-wrap:wrap;gap:8px;margin:22px 0}.tag-list span{padding:7px 10px;border:1px solid #DCE4ED;border-radius:999px;font-size:10px;color:#5D6B7B;font-weight:700}.project-copy a{font-size:13px;font-weight:800;color:var(--blue)}.commerce-card{width:82%;height:78%;border-radius:18px;background:var(--navy);color:#fff;padding:28px;box-shadow:0 26px 60px rgba(28,49,72,.18);position:relative;overflow:hidden}.commerce-card:after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,255,.28),transparent 68%);right:-70px;top:-70px}.commerce-top{display:flex;justify-content:space-between;color:#8DA6C5;font-size:8px;letter-spacing:.13em}.commerce-top strong{font-size:26px;color:#244B85}.commerce-card h4{font-size:31px;line-height:1.05;letter-spacing:-.05em;margin:45px 0 24px}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.metric-grid>div{border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px}.metric-grid small{font-size:6px;color:#7F94AE;display:block}.metric-grid b{font-size:10px;color:#7EAAFF}.chart-bars{position:absolute;left:28px;right:28px;bottom:28px;display:flex;align-items:flex-end;gap:8px;height:70px}.chart-bars i{flex:1;background:#244A83;border-radius:4px 4px 0 0}.chart-bars i:nth-child(1){height:24%}.chart-bars i:nth-child(2){height:38%}.chart-bars i:nth-child(3){height:31%}.chart-bars i:nth-child(4){height:54%}.chart-bars i:nth-child(5){height:70%}.chart-bars i:nth-child(6){height:88%;background:var(--blue)}

.process{background:var(--bg)}.process-line{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid #CED8E4;padding-top:28px;gap:18px}.process-step{position:relative}.process-step:before{content:"";position:absolute;top:-34px;left:0;width:11px;height:11px;border-radius:50%;background:#fff;border:3px solid var(--blue)}.process-step b{font-size:10px;color:var(--blue);letter-spacing:.1em}.process-step strong{display:block;font-size:12px;margin-top:12px}.process-step small{display:block;font-size:10px;color:var(--muted);margin-top:8px;line-height:1.5}

.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch}.price-card{border:1px solid var(--line);border-radius:20px;padding:28px;background:#fff;display:flex;flex-direction:column;min-height:570px;position:relative}.price-card.popular{border-color:#A7C2FF;box-shadow:0 22px 60px rgba(37,99,255,.1);transform:translateY(-8px)}.popular-badge{position:absolute;right:18px;top:18px;padding:6px 8px;background:#EAF1FF;color:var(--blue);font-size:8px;font-weight:800;letter-spacing:.08em;border-radius:999px}.plan{font-size:10px;font-weight:800;letter-spacing:.15em;color:var(--blue)}.price-card h3{font-size:45px;letter-spacing:-.055em;margin:13px 0 7px}.price-card h3 span{font-size:22px}.price-card p{font-size:12px;color:var(--muted);min-height:40px}.price-card ul{list-style:none;padding:22px 0 0;margin:20px 0 28px;border-top:1px solid var(--line);flex:1}.price-card li{font-size:12px;color:#465668;padding:7px 0 7px 22px;position:relative}.price-card li:before{content:"✓";position:absolute;left:0;color:var(--blue);font-weight:800}.price-card .btn{width:100%}

.faq{background:var(--bg)}.faq-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:80px}.accordion details{border-bottom:1px solid #DCE4EC}.accordion summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 0;font-weight:700;font-size:14px}.accordion summary::-webkit-details-marker{display:none}.accordion summary span{font-size:22px;color:var(--blue);transition:.2s}.accordion details[open] summary span{transform:rotate(45deg)}.accordion details p{margin:-4px 0 22px;color:var(--muted);font-size:13px;max-width:700px}

.contact{padding:110px 0}.contact-grid{display:grid;grid-template-columns:1fr .72fr;gap:76px;align-items:center}.contact-copy p{color:#A8B8CB;max-width:650px;font-size:15px}.contact-points{display:grid;gap:10px;margin-top:28px;color:#C4D2E3;font-size:12px}.contact-points span::first-letter{color:var(--blue-2)}.lead-form{background:#fff;color:var(--ink);padding:26px;border-radius:22px;box-shadow:0 28px 80px rgba(0,0,0,.25)}.form-head{margin-bottom:20px}.form-head strong{display:block;font-size:14px}.form-head small{font-size:10px;color:var(--muted)}.lead-form label{display:grid;gap:7px;font-size:10px;font-weight:700;margin-bottom:13px;color:#4B5B6C}.lead-form input,.lead-form select{width:100%;