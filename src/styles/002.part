%;background:#C7D0DB}.browser-top em{font-style:normal;font-size:9px;color:#8290A3;margin-left:10px;background:#fff;padding:5px 44px;border-radius:7px}.browser-body{height:365px;display:grid;grid-template-columns:62px 1fr;background:#FBFCFE}.mini-sidebar{background:#0A1422;padding:20px 13px}.mini-logo{width:24px;height:24px;background:var(--blue);border-radius:7px;color:#fff;display:grid;place-items:center;font-size:10px;font-weight:800;margin-bottom:32px}.mini-line{height:6px;border-radius:10px;background:#2D4058;margin-bottom:15px}.mini-line.active{background:var(--blue)}.mini-line.short{width:70%}.mini-page{padding:45px 40px;color:var(--ink);position:relative;overflow:hidden}.mini-badge{font-size:7px;letter-spacing:.18em;color:var(--blue);font-weight:800}.mini-title{height:18px;width:74%;border-radius:5px;background:#0C1727;margin-top:12px}.mini-title.short{width:58%;margin-top:8px}.mini-text{height:5px;width:68%;background:#D5DFEB;border-radius:6px;margin-top:18px}.mini-text.short{width:48%;margin-top:8px}.mini-buttons{display:flex;gap:8px;margin-top:20px}.mini-buttons span{width:75px;height:22px;border-radius:6px;background:var(--blue)}.mini-buttons span+span{background:#E5EBF2}.mini-chart{position:absolute;left:40px;right:30px;bottom:28px;height:110px;border:1px solid #E7EDF4;border-radius:12px;background:linear-gradient(to bottom,#fff,#F9FBFD);display:grid;place-items:center;color:var(--blue);padding:14px}.phone-card{position:absolute;left:-8px;bottom:4px;width:160px;height:326px;border:7px solid #101B29;border-radius:28px;background:#fff;box-shadow:0 32px 80px rgba(0,0,0,.38);z-index:4;overflow:hidden}.phone-notch{position:absolute;top:6px;left:50%;transform:translateX(-50%);width:65px;height:13px;background:#101B29;border-radius:20px;z-index:2}.phone-screen{padding:33px 15px 18px}.phone-brand{height:8px;width:36px;background:var(--blue);border-radius:5px}.phone-h1{height:12px;background:#101B29;border-radius:4px;margin-top:27px}.phone-h1.short{width:70%;margin-top:6px}.phone-p{height:5px;background:#CBD6E2;border-radius:5px;margin-top:15px;width:86%}.phone-cta{height:27px;border-radius:6px;background:var(--blue);margin-top:17px;width:86%}.phone-panel{height:118px;border-radius:9px;background:#EEF4FF;margin-top:21px}.floating-card{position:absolute;z-index:5;background:rgba(9,23,40,.94);border:1px solid rgba(255,255,255,.12);border-radius:13px;color:#fff;box-shadow:0 18px 40px rgba(0,0,0,.22);display:flex;align-items:center;gap:10px;padding:10px 13px;backdrop-filter:blur(14px)}.floating-card strong{display:block;font-size:10px}.floating-card small{display:block;font-size:8px;color:#8FA2B9;margin-top:2px}.status-icon{width:24px;height:24px;border-radius:8px;background:rgba(37,99,255,.16);color:#72A3FF;display:grid;place-items:center;font-size:11px;font-weight:800}.fc-one{top:15px;left:2%}.fc-two{right:-12px;bottom:72px}.fc-three{left:28%;bottom:-18px}

.industry-strip{border-bottom:1px solid var(--line);background:#fff}.strip-inner{min-height:84px;display:flex;align-items:center;gap:36px}.strip-label{font-size:10px;font-weight:800;letter-spacing:.16em;color:#99A6B7;white-space:nowrap}.strip-items{display:flex;justify-content:space-between;gap:28px;flex:1;color:#536276;font-size:13px;font-weight:700}.strip-items span{white-space:nowrap}

.section-heading{max-width:760px;margin-bottom:52px}.section-heading .kicker{margin-bottom:18px}.section-heading h2,.journey h2,.contact h2{font-size:clamp(38px,5vw,66px);line-height:1.03;letter-spacing:-.052em;margin:0 0 20px}.section-heading p{max-width:650px;color:var(--muted);font-size:16px;margin:0}.split-heading{max-width:none;display:grid;grid-template-columns:1fr .7fr;align-items:end;gap:70px}.split-heading p{padding-bottom:8px}.light{color:#77A6FF}
.problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.problem-card{padding:27px 25px 30px;border:1px solid var(--line);border-radius:18px;background:#fff;transition:.25s ease}.problem-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#D3DEEA}.problem-card b{font-size:11px;color:var(--blue);letter-spacing:.13em}.problem-card h3{font-size:17px;line-height:1.35;margin:26px 0 10px;letter-spacing:-.02em}.problem-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.7}

.services{background:var(--bg)}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.service-card{position:relative;min-height:320px;padding:31px;border-radius:20px;background:#fff;border:1px