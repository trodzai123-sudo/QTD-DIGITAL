ent button{left:20px;bottom:20px}.project-phone{width:84px;height:178px;right:18px;bottom:14px}.machine-art{width:100px;height:80px}.machine-body{width:75px;height:54px}.machine-head{width:52px;height:42px;border-width:8px}.laser{left:48px;height:48px}.commerce-card{width:95%;height:85%;padding:22px}.commerce-card h4{font-size:24px;margin-top:30px}.chart-bars{left:22px;right:22px;bottom:20px;height:48px}.project-copy h3{font-size:30px}.process-line{grid-template-columns:1fr;border-top:0;padding:0;gap:0}.process-step{padding:0 0 28px 36px;border-left:1px solid #CED8E4}.process-step:before{top:0;left:-6px}.pricing-grid{gap:14px}.faq-grid{gap:18px}.contact{padding:78px 0}.lead-form{padding:20px}.footer-grid{grid-template-columns:1fr 1fr;gap:35px}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{flex-direction:column}.brand-copy strong{font-size:18px}
